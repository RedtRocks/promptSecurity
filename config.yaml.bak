# agent-hardener configuration file
# Copy this file to config.yaml and fill in your values.
# All fields can also be set via environment variables (uppercase, underscore-separated).
# e.g., OPENAI_API_KEY=sk-... or AGENT_ENDPOINT=http://localhost:8000

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Any LiteLLM-compatible model string. Examples:
#   openai/gpt-4o
#   anthropic/claude-3-5-sonnet-20241022
#   ollama/llama3.2
#   azure/gpt-4o (requires azure_api_base + azure_api_version)
# For Ollama via Cloudflare tunnel:
#   default_model: "ollama/<your_model_name>"
default_model: "ollama/gemma3:27b:35b"

# ── API Keys ──────────────────────────────────────────────────────────────────
openai_api_key: "" # or set OPENAI_API_KEY env var
anthropic_api_key: "" # or set ANTHROPIC_API_KEY env var
azure_api_key: "" # or set AZURE_API_KEY env var
azure_api_base: "" # e.g., https://mydeployment.openai.azure.com/
azure_api_version: "" # e.g., 2024-02-01
ollama_base_url: "https://expenses-blink-titled-suburban.trycloudflare.com" # local Ollama or Cloudflare tunnel base URL
# Example tunnel URL (paste yours here):
# ollama_base_url: "https://<your-subdomain>.trycloudflare.com"

# ── Target Agent Endpoint ─────────────────────────────────────────────────────
# The live agent HTTP endpoint that will receive adversarial prompts.
# Must accept POST requests with {"prompt": "..."} and return a trajectory JSON.
# See docs/agent_endpoint_spec.md for the expected contract.
agent_endpoint: "http://127.0.0.1:8080"
# Optional: Bearer token for agent authentication
agent_auth_token: ""

# Optional: MCP transport type if the agent speaks MCP protocol natively
# Choices: "http" (default, plain JSON-RPC over HTTP) | "stdio" | "sse"
agent_transport: "http"

# ── Pipeline Settings ─────────────────────────────────────────────────────────
max_iterations: 6 # Max refinement iterations per attack (Stage 1.3)
attack_parallelism: 1 # Limit parallel attack cycles for stability on larger local models
attack_success_threshold: 0.3 # Score above which an attack is marked SUCCESS
grader_model: "qwen3:30b-a3b" # Override model for LLM-as-judge. Defaults to default_model.

# ── Output Settings ───────────────────────────────────────────────────────────
output_dir: "./hardener_output" # Default output directory for reports
