<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>agent-hardener report: {{ tool.name }}</title>
  <style>
    :root {
      --bg: #f6f8fb;
      --panel: #ffffff;
      --border: #dce3ee;
      --text: #122033;
      --muted: #5d6d83;
      --good: #127c3a;
      --warn: #9a6400;
      --bad: #b42318;
      --accent: #005cc5;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: "Segoe UI", Tahoma, Arial, sans-serif;
      line-height: 1.45;
    }
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 20px;
    }
    .panel {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 16px;
      margin-bottom: 14px;
    }
    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 10px;
      margin-bottom: 10px;
    }
    h1 { margin: 0; font-size: 22px; }
    h2 { margin: 0 0 10px 0; font-size: 17px; }
    .meta { color: var(--muted); font-size: 12px; text-align: right; }
    .muted { color: var(--muted); }
    .stats {
      display: grid;
      grid-template-columns: repeat(4, minmax(120px, 1fr));
      gap: 10px;
    }
    .stat {
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 10px;
      background: #fbfcfe;
    }
    .stat .label { color: var(--muted); font-size: 12px; }
    .stat .value { font-size: 24px; font-weight: 700; margin-top: 3px; }
    .good { color: var(--good); }
    .warn { color: var(--warn); }
    .bad { color: var(--bad); }
    .badge {
      display: inline-block;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      border-radius: 999px;
      padding: 2px 9px;
      border: 1px solid;
      white-space: nowrap;
    }
    .b-good { color: var(--good); border-color: #8ad6a7; background: #e9f8ef; }
    .b-warn { color: var(--warn); border-color: #e7c276; background: #fff7e2; }
    .b-bad { color: var(--bad); border-color: #ef9a95; background: #fff0ef; }
    .b-neutral { color: #23436e; border-color: #aec4e6; background: #eef4ff; }
    .table-wrap { overflow-x: auto; }
    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 900px;
      font-size: 13px;
    }
    th, td {
      text-align: left;
      vertical-align: top;
      border-bottom: 1px solid var(--border);
      padding: 9px 8px;
    }
    th {
      color: var(--muted);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      background: #f8fafd;
    }
    details { margin-top: 6px; }
    summary { cursor: pointer; color: var(--accent); }
    .code {
      white-space: pre-wrap;
      word-break: break-word;
      background: #0d1524;
      color: #d6e7ff;
      border-radius: 8px;
      padding: 10px;
      font-family: Consolas, "Courier New", monospace;
      font-size: 12px;
      margin-top: 6px;
    }
    .list { margin: 0; padding-left: 18px; }
    .foot { color: var(--muted); font-size: 12px; text-align: center; margin-top: 10px; }
    @media (max-width: 900px) {
      .stats { grid-template-columns: repeat(2, minmax(120px, 1fr)); }
      .meta { text-align: left; }
      .header { flex-direction: column; }
    }
  </style>
</head>
<body>
<div class="container">

  <div class="panel">
    <div class="header">
      <div>
        <h1>agent-hardener report</h1>
        <div class="muted">Tool: <strong>{{ tool.name }}</strong></div>
      </div>
      <div class="meta">
        <div>Generated: {{ generated_at }}</div>
        <div>Pipeline version: 1.0</div>
      </div>
    </div>

    <div class="stats">
      <div class="stat">
        <div class="label">Total Attacks</div>
        <div class="value">{{ analysis.total_attacks_attempted }}</div>
      </div>
      <div class="stat">
        <div class="label">Succeeded (Current Threshold)</div>
        <div class="value {% if analysis.attacks_succeeded > 0 %}bad{% else %}good{% endif %}">{{ analysis.attacks_succeeded }}</div>
      </div>
      <div class="stat">
        <div class="label">Policy Rules</div>
        <div class="value">{{ policy.enforcement_rules | length }}</div>
      </div>
      <div class="stat">
        <div class="label">Primary Exploit Vector</div>
        <div class="value" style="font-size: 16px; margin-top: 8px;">{{ analysis.primary_exploit_vector.value }}</div>
      </div>
    </div>
  </div>

  <div class="panel">
    <h2>Attack Outcomes (Prompt -> Tool Result -> Policy Mitigation)</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Attack</th>
            <th>Prompt Used</th>
            <th>Worked On Tool?</th>
            <th>Attack Worked?</th>
            <th>Policy Generated</th>
            <th>Policy Mitigated Attack?</th>
          </tr>
        </thead>
        <tbody>
          {% for row in attack_summaries %}
          <tr>
            <td>
              <div><strong>{{ row.record_id }}</strong></div>
              <div class="muted">{{ row.harm_category }} | {{ row.attack_intensity }}</div>
              <div class="muted">score={{ "%.2f"|format(row.final_score) }}</div>
            </td>
            <td>
              <details>
                <summary>View final prompt</summary>
                <div class="code">{{ row.final_prompt }}</div>
              </details>
            </td>
            <td>
              {% if row.worked_on_tool %}
                <span class="badge b-good">yes</span>
              {% else %}
                <span class="badge b-bad">no</span>
              {% endif %}
            </td>
            <td>
              {% if row.attack_success %}
                <span class="badge b-bad">yes</span>
              {% else %}
                <span class="badge b-good">no</span>
              {% endif %}
            </td>
            <td>
              {% if row.policy_rule_ids %}
                {% for rid in row.policy_rule_ids %}
                  <div><span class="badge b-neutral">{{ rid }}</span></div>
                {% endfor %}
                <div class="muted" style="margin-top:4px">actions: {{ row.policy_actions | join(", ") }}</div>
              {% else %}
                <span class="muted">none specific</span>
              {% endif %}
            </td>
            <td>
              {% if row.policy_mitigated == "yes" %}
                <span class="badge b-good">yes</span>
              {% elif row.policy_mitigated == "no-explicit-rule" %}
                <span class="badge b-warn">unknown</span>
                <div class="muted" style="margin-top:4px">no explicit per-attack rule</div>
              {% else %}
                <span class="badge b-neutral">n/a</span>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  <div class="panel">
    <h2>Policy Generated</h2>
    <table>
      <tbody>
        <tr>
          <th style="width: 280px;">Confidentiality (read/write)</th>
          <td>
            {{ policy.confidentiality_annotations.read_confidentiality }} / {{ policy.confidentiality_annotations.write_confidentiality }}
          </td>
        </tr>
        <tr>
          <th>Initial session taint</th>
          <td>{{ policy.session_taint_rules.initial_session_taint }}</td>
        </tr>
        <tr>
          <th>Coverage summary</th>
          <td>
            fully_blocked={{ policy.policy_coverage.attacks_fully_blocked_by_policy }},
            partially_mitigated={{ policy.policy_coverage.attacks_partially_mitigated }},
            model_level={{ policy.policy_coverage.attacks_requiring_model_level_defense }},
            unmitigated={{ policy.policy_coverage.unmitigated_attacks }}
          </td>
        </tr>
      </tbody>
    </table>

    <h2 style="margin-top:14px;">Enforcement Rules</h2>
    {% if policy.enforcement_rules %}
      <ul class="list">
        {% for rule in policy.enforcement_rules %}
          <li>
            <strong>{{ rule.rule_id }}</strong> ({{ rule.action }})
            - motivated by {{ rule.motivated_by_attack }}
            <div class="muted">{{ rule.trigger_condition }}</div>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <div class="muted">No enforcement rules were generated.</div>
    {% endif %}
  </div>

  <div class="foot">
    Streamlined report: prompt, tool outcome, policy output, and mitigation status.
  </div>
</div>
</body>
</html>
